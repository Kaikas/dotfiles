# This file is interpreted as a template by chezmoi.

# Machine-local secrets / host-specific overrides — never manage or commit these.
.zshrc.local

# Work-laptop-only desktop config (display/lock helper scripts, HiDPI Chromium,
# install scripts). Managed only where [data] workLaptop = true (set in that
# machine's ~/.config/chezmoi/chezmoi.toml). Ignored everywhere else so these
# never apply on this machine or other machines.
#
# .config/i3/config itself is NOT gated: it is one template for all hosts, with
# the work-laptop-only parts (lock.sh, xss-lock, xrdb, displays.sh, hotplug,
# $alt bindings) behind {{ "{{ if ne $host \"nyx\" }}" }} inside the template.

# The Live sync (button's ~/Live, mostly running-container state) is only
# meaningful on nyx -- the other three syncs are nyx-specific too but predate
# this gating; this one is deliberately scoped from the start.
{{ if ne .chezmoi.hostname "nyx" }}
.unison/desktop-server-live.prf
.config/systemd/user/unison-live.service
.config/systemd/user/unison-live.timer
{{ end }}

# Desktop-only static screen layout (fixed dual 3840x2160 on the dock).
# Referenced from .config/i3/config in the nyx branch. Other hosts do their
# display setup dynamically via .config/i3/displays.sh, so never apply it there.
{{ if ne .chezmoi.hostname "nyx" }}
.screenlayout/default.sh
{{ end }}

# .Xresources is NOT work-laptop-only: it carries the per-host HiDPI value, so
# it is managed on every host that needs one — erebos (13.4" 4K) and nyx (dual
# 31.5" 4K). Hosts with no branch in the template get an empty Xft.dpi section.
{{ if and (not .workLaptop) (ne .chezmoi.hostname "nyx") }}
.Xresources
{{ end }}

# polybar is managed on every host, not just the work laptop: the config is
# worth versioning even where the bar is not what actually runs. config.ini is
# one template with the per-host dpi/height/module differences inside, the same
# way .config/i3/config is handled.

{{ if not .workLaptop }}
.config/i3/displays.sh
.config/i3/lid-monitor.sh
.config/i3/lock.sh
.config/i3/monitor-hotplug.sh
.local/share/applications/chromium.desktop
install-nerd-font.sh
install-zsh
{{ end }}

#!/usr/bin/env bash
# Build the wallpapers this machine uses. Kept in the dotfiles because the
# images themselves live in ~/Wallpaper, which is not managed by chezmoi -- so
# without this script a fresh install would have an i3 config pointing at files
# nobody knows how to recreate.
#
#   mk-wallpaper logo [bg] [fg] [out]   distro logo, centred on a flat dark
#                                       field, rendered from SVG so it is sharp
#                                       at any resolution
#   mk-wallpaper ai <prompt> [out.png]  generate a wallpaper via the OpenAI
#                                       image API, then lock its base colour to
#                                       solarized base03 so it matches the theme
#   mk-wallpaper xkcd <num> [out.png]   dark 4K wallpaper from an xkcd comic
#   mk-wallpaper span <src> [out.png]   duplicate an image across all monitors,
#                                       for i3lock (see "why span" below)
#
# Why span: i3lock draws its image once at (0,0) of the whole X screen -- it
# neither scales nor centres per monitor. On a multi-head setup an image the
# size of one screen leaves the rest black, so the image has to be as wide as
# all monitors combined, with the artwork repeated per monitor.

set -euo pipefail

die() { printf 'mk-wallpaper: %s\n' "$*" >&2; exit 1; }

for dep in magick curl python3 xrandr; do
  command -v "$dep" >/dev/null || die "missing dependency: $dep"
done

WALLDIR="${WALLDIR:-$HOME/Wallpaper}"
mkdir -p "$WALLDIR"

# Resolve a real font file; -font with a family name is unreliable headless.
font_file() {
  fc-match -f '%{file}' 'JetBrainsMono Nerd Font Mono' 2>/dev/null \
    || fc-match -f '%{file}' monospace
}

# Per-monitor resolution and monitor count, straight from the live X server, so
# this keeps working if the screens change again.
geometry() {
  xrandr --query | awk '
    / connected/ && match($0, /[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/) {
      split(substr($0, RSTART, RLENGTH), a, /[x+]/)
      w = a[1]; h = a[2]; n++
    }
    END { if (!n) exit 1; print w, h, n }'
}

cmd_xkcd() {
  local num="$1" out="${2:-$WALLDIR/xkcd-$1.png}"
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN

  curl -sfL --max-time 20 "https://xkcd.com/$num/info.0.json" -o "$tmp/meta.json" \
    || die "could not fetch xkcd $num"

  local url title alt
  url=$(python3   -c "import json;print(json.load(open('$tmp/meta.json'))['img'])")
  title=$(python3 -c "import json;print(json.load(open('$tmp/meta.json'))['title'])")
  alt=$(python3   -c "import json;print(json.load(open('$tmp/meta.json'))['alt'])")

  # Prefer the retina asset -- these comics are ~400px native and every pixel of
  # headroom counts before upscaling onto a 4K canvas.
  curl -sfL --max-time 20 "${url%.png}_2x.png" -o "$tmp/raw.png" \
    || curl -sfL --max-time 20 "$url" -o "$tmp/raw.png" \
    || die "could not fetch comic image"

  local W H N; read -r W H N < <(geometry)

  # xkcd is black line art on white. Make the paper transparent and recolour the
  # strokes, so the comic sits on our dark base instead of a white box.
  magick "$tmp/raw.png" -colorspace gray -negate "$tmp/mask.png"
  magick -size "$(magick identify -format '%wx%h' "$tmp/raw.png")" xc:'#dcdce8' \
         "$tmp/mask.png" -alpha off -compose copy-opacity -composite "$tmp/lines.png"

  # Lanczos keeps line art from turning to mush; unsharp restores stroke edges.
  magick "$tmp/lines.png" \
         -filter Lanczos -resize "$((W * 52 / 100))x$((H * 58 / 100))" \
         -unsharp 0x1.1+0.7+0.02 "$tmp/art.png"

  # Near-black base with a faint purple lift, echoing Garuda's accent.
  magick -size "${W}x${H}" radial-gradient:'#1d1730'-'#0b0b12' \
         -gravity center "$tmp/art.png" -geometry "+0-$((H / 20))" -composite "$tmp/bg.png"

  local font; font="$(font_file)"
  magick "$tmp/bg.png" -gravity south \
    -font "$font" -pointsize $((H * 21 / 1000)) -fill '#8f8fa8' \
    -annotate "+0+$((H * 106 / 1000))" "$title" \
    -font "$font" -pointsize $((H * 125 / 10000)) -fill '#5c5c72' \
    -annotate "+0+$((H * 69 / 1000))"  "$(printf '%s' "$alt" | fold -s -w 110)" \
    -font "$font" -pointsize $((H * 10 / 1000)) -fill '#3f3f52' \
    -annotate "+0+$((H * 32 / 1000))"  "xkcd.com/$num  ·  CC BY-NC 2.5  ·  Randall Munroe" \
    "$out"

  magick identify -format 'wrote %f  %wx%h  mean=%[fx:mean]\n' "$out"
}

cmd_logo() {
  local bg="${1:-#0f1216}" fg="${2:-#4b525a}" out="${3:-$WALLDIR/arch-logo-4k.png}"
  local svg="${LOGO_SVG:-/usr/share/pixmaps/archlinux-logo.svg}"

  command -v rsvg-convert >/dev/null || die "missing dependency: rsvg-convert (pkg: librsvg)"
  [ -f "$svg" ] || die "no such svg: $svg"

  local W H N; read -r W H N < <(geometry)
  local lh="${LOGO_H:-$((H * 5 / 12))}"   # 900px on a 2160-tall screen
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN

  # Take only the first path and re-emit it with our own fill. Building a fresh
  # element drops any style="fill:url(#gradient)" on the original, which would
  # otherwise beat a plain fill attribute and bring the brand colours back.
  #
  # First path is deliberate: the Arch logo's other two paths are the tiny (TM)
  # letterforms, which land as specks on a wallpaper. The Garuda logo is a
  # single path, so it is unaffected.
  #
  # The viewBox MUST come from the source -- Arch is 0 0 256 256 and Garuda is
  # 0 0 512 512, and hardcoding one renders the other cropped to a quadrant.
  python3 -c "
import re, sys
s = open(sys.argv[1]).read()
m = re.search(r'<path[^>]*\bd=\"([^\"]+)\"', s)
if not m: sys.exit('could not find a path in ' + sys.argv[1])
vb = re.search(r'viewBox=\"([^\"]+)\"', s)
if not vb: sys.exit('no viewBox in ' + sys.argv[1])
print('<svg version=\"1.1\" viewBox=\"%s\" xmlns=\"http://www.w3.org/2000/svg\">'
      '<path fill=\"%s\" fill-rule=\"evenodd\" d=\"%s\"/></svg>'
      % (vb.group(1), sys.argv[2], m.group(1)))
" "$svg" "$fg" > "$tmp/logo.svg" || die "could not rewrite svg"

  rsvg-convert -h "$lh" -o "$tmp/logo.png" "$tmp/logo.svg" || die "rsvg-convert failed"
  magick -size "${W}x${H}" xc:"$bg" "$tmp/logo.png" -gravity center -composite "$out"

  magick identify -format "wrote %f  %wx%h  bg=$bg fg=$fg logo=${lh}px  mean=%[fx:mean]\n" "$out"
}

# Shift the image so its dominant colour lands exactly on $BASE (solarized
# base03 by default). Image models get close to a requested hex but drift a few
# values, which is visible when the wallpaper butts up against a terminal using
# the real colour. Subtracting the offset keeps line contrast intact -- scaling
# the channels instead would flatten it.
palette_lock() {
  local img="$1" base="${BASE:-#002b36}"
  local dom tr tg tb dr dg db

  dom=$(magick "$img" -resize 600x -colors 4 -format %c -depth 8 histogram:info:- \
        | sort -rn | head -1 | grep -oE '\(([0-9]+,){2}[0-9]+\)' | head -1 | tr -d '()')
  [ -n "$dom" ] || { echo "  palette-lock: could not sample, skipping"; return; }

  read -r tr tg tb < <(magick xc:"$base" -format '%[fx:int(255*r)] %[fx:int(255*g)] %[fx:int(255*b)]' info:)
  dr=$(( ${dom%%,*} - tr ))
  db=$(( ${dom##*,} - tb ))
  local mid="${dom#*,}"; dg=$(( ${mid%%,*} - tg ))

  echo "  palette-lock: rgb($dom) -> $base  (delta $dr,$dg,$db)"
  local args=()
  for ch in R:$dr G:$dg B:$db; do
    local c="${ch%%:*}" d="${ch##*:}"
    [ "$d" -eq 0 ] && continue
    if [ "$d" -gt 0 ]; then
      args+=(-channel "$c" -evaluate subtract "$(( d * 10000 / 255 ))e-2%" +channel)
    else
      args+=(-channel "$c" -evaluate add "$(( -d * 10000 / 255 ))e-2%" +channel)
    fi
  done
  [ ${#args[@]} -eq 0 ] || magick "$img" "${args[@]}" "$img"
}

cmd_ai() {
  local prompt="$1" out="${2:-$WALLDIR/ai-wallpaper.png}"
  [ -n "${OPENAI_API_KEY:-}" ] || die "OPENAI_API_KEY is not set (it lives in ~/.zshrc.local)"

  local W H N; read -r W H N < <(geometry)
  # gpt-image-2 caps the longest edge at 3840, which happens to be exactly one
  # 4K screen -- so ask for the native size and never upscale.
  [ "$W" -gt 3840 ] && W=3840

  OPENAI_MODEL="${OPENAI_MODEL:-gpt-image-2}" \
  python3 -c '
import base64, json, os, sys, urllib.request
prompt, out, size = sys.argv[1], sys.argv[2], sys.argv[3]
# Steer away from the two things that make a generated image useless here.
prompt += ". No text, no words, no letters, no numbers, no logos, no watermark."
body = json.dumps({"model": os.environ["OPENAI_MODEL"], "prompt": prompt,
                   "size": size, "n": 1}).encode()
req = urllib.request.Request("https://api.openai.com/v1/images/generations",
      data=body, headers={"Authorization": "Bearer " + os.environ["OPENAI_API_KEY"],
                          "Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=300) as r:
        item = json.load(r)["data"][0]
except urllib.error.HTTPError as e:
    sys.exit("  api error %d: %s" % (e.code, e.read().decode()[:300]))
if "b64_json" in item:
    open(out, "wb").write(base64.b64decode(item["b64_json"]))
else:
    urllib.request.urlretrieve(item["url"], out)
' "$prompt" "$out" "${W}x${H}" || die "generation failed"

  palette_lock "$out"
  magick identify -format 'wrote %f  %wx%h  mean=%[fx:mean]\n' "$out"
}

cmd_span() {
  local src="$1" out="${2:-$WALLDIR/lock.png}"
  [ -f "$src" ] || die "no such file: $src"

  local W H N; read -r W H N < <(geometry)
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN

  # Fill one monitor, cropping any overhang rather than distorting. If the source
  # is already exactly one monitor, copy it untouched -- rescaling and
  # resharpening a pixel-perfect source only adds haloes around hard edges.
  if [ "$(magick identify -format '%wx%h' "$src")" = "${W}x${H}" ]; then
    echo "  source already ${W}x${H}, copying without rescale"
    cp "$src" "$tmp/one.png"
  else
    magick "$src" -filter Lanczos -resize "${W}x${H}^" \
           -gravity center -extent "${W}x${H}" -unsharp 0x0.8+0.4+0.02 "$tmp/one.png"
  fi

  local dup=(); for ((i = 0; i < N; i++)); do dup+=("$tmp/one.png"); done
  magick "${dup[@]}" +append "$out"

  magick identify -format "wrote %f  %wx%h  (${N}x ${W}x${H})  mean=%[fx:mean]\n" "$out"
}

case "${1:-}" in
  logo) shift; cmd_logo "$@" ;;
  ai)   shift; [ $# -ge 1 ] || die "usage: mk-wallpaper ai <prompt> [out.png]"; cmd_ai "$@" ;;
  xkcd) shift; [ $# -ge 1 ] || die "usage: mk-wallpaper xkcd <num> [out.png]"; cmd_xkcd "$@" ;;
  span) shift; [ $# -ge 1 ] || die "usage: mk-wallpaper span <src> [out.png]"; cmd_span "$@" ;;
  *)    die "usage: mk-wallpaper {logo [bg] [fg]|ai <prompt>|xkcd <num>|span <src>} [out.png]" ;;
esac

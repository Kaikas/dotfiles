{{- $host := lower .chezmoi.hostname -}}
{{- if eq $host "erebos" }}
! HiDPI scaling (erebos: 13.4-inch 4K panel ~338 physical DPI)
Xft.dpi: 192
{{- else if eq $host "nyx" }}
! HiDPI scaling (nyx: two 31.5-inch 4K panels, ~140 physical DPI -> 1.5x).
! Keeps everything the same physical size as the old 2560x1440 screens, just
! sharper: 3840x2160 at 1.5x is an effective 2560x1440 per screen.
! Read at login by /etc/lightdm/Xsession, which merges ~/.Xresources -- i3 does
! not run xrdb on this host.
Xft.dpi: 144
{{- end }}

Xft.antialias: true
Xft.hinting:   true
Xft.hintstyle: hintslight
Xft.rgba:      rgb
Xft.lcdfilter: lcddefault
